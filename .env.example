# MongoDB connection string (add credentials if the instance requires auth)
MONGODB_URI=mongodb://127.0.0.1:27017/token-meter

# Encrypts member-supplied secrets (GitHub tokens) at rest. Any long random string.
TOKEN_FOREST_SECRET=

# --- Server-side poller credentials (leave blank to disable a connector) ---

# Cursor Teams admin API key (team admin > settings > API keys)
CURSOR_API_KEY=

# Anthropic Admin API key (sk-ant-admin...) for /v1/organizations/usage_report/claude_code
ANTHROPIC_ADMIN_KEY=

# OpenAI Admin key for /v1/organization/usage/completions
OPENAI_ADMIN_KEY=

# Comma-separated OpenAI project ids whose API-key usage must NOT count as
# member usage (service/product keys are attributed to the key creator's
# user_id and would inflate that member's numbers).
OPENAI_EXCLUDE_PROJECTS=

# --- Slack weekly report ---
SLACK_WEBHOOK_URL=

# Team-wide tracking epoch: a connector's FIRST sync backfills from this date
# (default: 30 days ago when unset). Later incremental syncs are unaffected.
TOKEN_FOREST_BACKFILL_START=2026-06-01

# --- Public ingest tunnel (Cloudflare) — OPTIONAL ---
# Named-tunnel run token (eyJ...) from Cloudflare Zero Trust > Networks > Tunnels.
# Exposes only /api/ingest, /api/limits and /install.sh publicly so members can
# upload without a VPN. Leave blank if you don't use the tunnel and remove the
# `cloudflared` service from docker-compose.yml (the app itself runs fine).
CLOUDFLARE_TUNNEL_TOKEN=

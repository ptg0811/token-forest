# MongoDB connection string for HOST-side tools (admin CLI, mongodump, pnpm dev).
# The bundled compose Mongo publishes 27017 on loopback 27201; inside compose the
# app always uses mongodb://mongo:27017/token-meter (set in docker-compose.yml).
MONGODB_URI=mongodb://127.0.0.1:27201/token-meter

# Encrypts member-supplied secrets (GitHub tokens) at rest. Any long random string.
TOKEN_FOREST_SECRET=

# --- Server-side poller credentials (leave blank to disable a connector) ---

# Cursor Teams admin API key (team admin > settings > API keys)
CURSOR_API_KEY=

# Anthropic Admin API key (sk-ant-admin...) for /v1/organizations/usage_report/claude_code
ANTHROPIC_ADMIN_KEY=

# OpenAI Admin key for /v1/organization/usage/completions
OPENAI_ADMIN_KEY=

# Comma-separated OpenAI project ids whose API-key usage must NOT count as
# member usage (service/product keys are attributed to the key creator's
# user_id and would inflate that member's numbers).
OPENAI_EXCLUDE_PROJECTS=

# --- Slack weekly report ---
SLACK_WEBHOOK_URL=

# Team-wide tracking epoch: a connector's FIRST sync backfills from this date
# (default: 30 days ago when unset). Later incremental syncs are unaffected.
TOKEN_FOREST_BACKFILL_START=2026-06-01

# --- Dashboard identity (reverse-proxy injected) ---

# Public dashboard URL used in install-banner links and invites (the dashboard
# may live on a different host than ingest, behind the login proxy).
# Unset = fall back to the ingest host.
TOKEN_FOREST_DASHBOARD_URL=

# Header carrying the authenticated requester's email. The proxy fronting the
# dashboard MUST overwrite this header with the session value — otherwise it
# is forgeable. oauth2-proxy: x-forwarded-email / tailscale serve:
# tailscale-user-login (default when unset).
TOKEN_FOREST_IDENTITY_HEADER=

# Set to 1 only when such a proxy fronts the dashboard.
# Legacy alias TOKEN_FOREST_TRUST_TAILSCALE_HEADERS is still honored.
TOKEN_FOREST_TRUST_IDENTITY_HEADERS=

# oauth2-proxy credentials (dashboard-auth service; see docker-compose.yml).
# COOKIE_SECRET must decode to exactly 16, 24, or 32 bytes — e.g.
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
